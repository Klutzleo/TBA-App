# Example environment for local dev (no secrets)
DATABASE_URL=sqlite:///local.db
API_KEY=devkey

# JWT Authentication
# IMPORTANT: Generate a secure random secret key for production
# Example: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# Email Service (Optional - for password resets and the notification digest)
# Sent via Resend (backend/email_service.py). If RESEND_API_KEY is not set, password
# reset links are printed to console instead (dev mode), and digest emails are skipped.
RESEND_API_KEY=your-resend-api-key-here
FROM_EMAIL=noreply@tba-app.com
FRONTEND_URL=https://tba-app-production.up.railway.app

# Notification digest (Optional) — IANA timezone for the twice-daily (9am/6pm) email
# sweep. Defaults to America/New_York if unset.
DIGEST_TIMEZONE=America/New_York
